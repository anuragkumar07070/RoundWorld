<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RoundWorld - Discover Amazing Places</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        * {
            font-family: 'Poppins', sans-serif;
        }
        
        /* Hero Section with Parallax Effect */
        .hero-section {
            position: relative;
            background: linear-gradient(135deg, #fe424d 0%, #ff8a8a 50%, #ff6b6b 100%);
            border-radius: 0 0 2rem 2rem;
            padding: 4rem 2rem;
            margin-bottom: 3rem;
            overflow: hidden;
        }
        
        .hero-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320"><path fill="rgba(255,255,255,0.1)" fill-opacity="1" d="M0,96L48,112C96,128,192,160,288,160C384,160,480,128,576,122.7C672,117,768,139,864,154.7C960,171,1056,181,1152,165.3C1248,149,1344,107,1392,85.3L1440,64L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path></svg>') repeat-x bottom;
            background-size: cover;
            opacity: 0.3;
            pointer-events: none;
        }
        
        .hero-content {
            position: relative;
            z-index: 2;
            text-align: center;
            color: white;
            max-width: 800px;
            margin: 0 auto;
        }
        
        .hero-badge {
            display: inline-block;
            background: rgba(255,255,255,0.2);
            backdrop-filter: blur(10px);
            padding: 0.5rem 1rem;
            border-radius: 2rem;
            font-size: 0.85rem;
            margin-bottom: 1rem;
            font-weight: 500;
        }
        
        .hero-title {
            font-family: 'Playfair Display', serif;
            font-size: 3.5rem;
            font-weight: 800;
            margin-bottom: 1rem;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.1);
        }
        
        .hero-subtitle {
            font-size: 1.1rem;
            opacity: 0.95;
            margin-bottom: 2rem;
        }
        
        /* Modern Search Bar */
        .search-container {
            max-width: 600px;
            margin: 0 auto;
            background: white;
            border-radius: 3rem;
            padding: 0.5rem;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        }
        
        .search-input {
            border: none;
            background: transparent;
            padding: 0.75rem 1.5rem;
            font-size: 1rem;
            flex: 1;
        }
        
        .search-input:focus {
            outline: none;
        }
        
        .search-btn {
            background: #fe424d;
            border: none;
            border-radius: 2.5rem;
            padding: 0.75rem 1.5rem;
            color: white;
            font-weight: 600;
            transition: all 0.3s;
        }
        
        .search-btn:hover {
            background: #dc3545;
            transform: scale(1.02);
        }
        
        /* Category Filter - Modern Tabs */
        .category-section {
            margin-bottom: 2rem;
        }
        
        .category-scroll {
            display: flex;
            overflow-x: auto;
            gap: 0.75rem;
            padding: 0.5rem 0;
            scrollbar-width: thin;
            -webkit-overflow-scrolling: touch;
        }
        
        .category-scroll::-webkit-scrollbar {
            height: 4px;
        }
        
        .category-scroll::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }
        
        .category-scroll::-webkit-scrollbar-thumb {
            background: #fe424d;
            border-radius: 10px;
        }
        
        .category-card {
            flex-shrink: 0;
            text-align: center;
            padding: 1rem 1.5rem;
            background: white;
            border-radius: 2rem;
            cursor: pointer;
            transition: all 0.3s;
            border: 2px solid transparent;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }
        
        .category-card:hover {
            transform: translateY(-5px);
            border-color: #fe424d;
        }
        
        .category-card.active {
            background: #fe424d;
            color: white;
        }
        
        .category-icon {
            font-size: 1.5rem;
            margin-bottom: 0.5rem;
        }
        
        .category-name {
            font-size: 0.85rem;
            font-weight: 500;
        }
        
        /* Stats Bar */
        .stats-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding: 1rem 0;
            border-bottom: 2px solid #f0f0f0;
        }
        
        .results-count {
            font-weight: 500;
            color: #666;
        }
        
        .results-count span {
            color: #fe424d;
            font-size: 1.5rem;
            font-weight: 700;
        }
        
        .sort-select {
            border: 1px solid #e0e0e0;
            border-radius: 2rem;
            padding: 0.5rem 1rem;
            background: white;
            font-size: 0.9rem;
        }
        
        /* Premium Cards */
        .premium-card {
            border: none;
            border-radius: 1.5rem;
            overflow: hidden;
            background: white;
            margin-bottom: 2rem;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            position: relative;
        }
        
        .premium-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 25px 40px rgba(0,0,0,0.15);
        }
        
        .card-badge {
            position: absolute;
            top: 1rem;
            left: 1rem;
            z-index: 10;
            background: #fe424d;
            color: white;
            padding: 0.3rem 0.8rem;
            border-radius: 2rem;
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        
        .card-badge.featured {
            background: linear-gradient(135deg, #f5af19, #f12711);
        }
        
        .image-wrapper {
            position: relative;
            height: 260px;
            overflow: hidden;
        }
        
        .card-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s cubic-bezier(0.3, 0.3, 0.1, 1);
        }
        
        .premium-card:hover .card-image {
            transform: scale(1.1);
        }
        
        .overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(to top, rgba(0,0,0,0.7), transparent);
            padding: 2rem 1rem 1rem;
            color: white;
        }
        
        .overlay-price {
            font-size: 1.5rem;
            font-weight: 700;
        }
        
        .overlay-price small {
            font-size: 0.8rem;
            font-weight: 400;
        }
        
        .card-content {
            padding: 1.25rem;
        }
        
        .card-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.2rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
            color: #222;
        }
        
        .card-location {
            font-size: 0.85rem;
            color: #666;
            margin-bottom: 1rem;
        }
        
        .card-location i {
            color: #fe424d;
        }
        
        .tags-cloud {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-bottom: 1rem;
        }
        
        .tag-pill {
            background: #f5f5f5;
            padding: 0.3rem 0.8rem;
            border-radius: 2rem;
            font-size: 0.7rem;
            font-weight: 500;
            color: #555;
            transition: all 0.2s;
        }
        
        .tag-pill:hover {
            background: #fe424d;
            color: white;
            transform: translateY(-2px);
        }
        
        .card-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 1rem;
            border-top: 1px solid #f0f0f0;
        }
        
        .price-tag {
            font-size: 1.1rem;
            font-weight: 700;
            color: #fe424d;
        }
        
        .price-tag small {
            font-size: 0.7rem;
            font-weight: 400;
            color: #999;
        }
        
        .explore-btn {
            background: white;
            border: 2px solid #fe424d;
            color: #fe424d;
            padding: 0.5rem 1.2rem;
            border-radius: 2rem;
            font-size: 0.85rem;
            font-weight: 600;
            transition: all 0.3s;
        }
        
        .explore-btn:hover {
            background: #fe424d;
            color: white;
            transform: translateX(5px);
        }
        
        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 4rem;
            background: linear-gradient(135deg, #f8f9fa 0%, #fff 100%);
            border-radius: 2rem;
        }
        
        .empty-state i {
            font-size: 5rem;
            color: #fe424d;
            margin-bottom: 1rem;
        }
        
        /* CTA Banner */
        .cta-banner {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            border-radius: 2rem;
            padding: 3rem;
            margin-top: 3rem;
            color: white;
            text-align: center;
        }
        
        .cta-button {
            background: #fe424d;
            color: white;
            border: none;
            padding: 0.8rem 2rem;
            border-radius: 3rem;
            font-weight: 600;
            margin-top: 1rem;
            transition: all 0.3s;
        }
        
        .cta-button:hover {
            transform: scale(1.05);
            background: #ff6b6b;
        }
        
        /* Responsive */
        @media (max-width: 768px) {
            .hero-title {
                font-size: 2rem;
            }
            
            .image-wrapper {
                height: 200px;
            }
        }
    </style>
</head>
<body>
    <%- include('../includes/navbar.ejs') %>
    
    <div class="container-fluid px-4">
        <!-- Hero Section -->
        <div class="hero-section">
            <div class="hero-content">
                <div class="hero-badge">
                    <i class="fas fa-globe"></i> 500+ Destinations Worldwide
                </div>
                <h1 class="hero-title">
                    Find Your Dream<br>Escape
                </h1>
                <p class="hero-subtitle">
                    Discover unique homes, luxury villas, and cozy cabins — curated just for you
                </p>
                
                <div class="search-container">
                    <form action="/listings" method="GET" class="d-flex">
                        <input type="text" 
                               name="search" 
                               class="search-input" 
                               placeholder="🔍 Search destinations..."
                               value="<%= typeof search !== 'undefined' ? search : '' %>">
                        <button type="submit" class="search-btn">
                            Explore Now <i class="fas fa-arrow-right"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="container">
            <!-- Category Filter -->
            <% if (typeof allTags !== 'undefined' && allTags && allTags.length > 0) { %>
            <div class="category-section">
                <div class="category-scroll">
                    <div class="category-card <%= typeof activeTag === 'undefined' || !activeTag ? 'active' : '' %>" 
                         onclick="location.href='/listings'">
                        <div class="category-icon">✨</div>
                        <div class="category-name">All</div>
                    </div>
                    <% for(var i = 0; i < allTags.length; i++) { 
                        var tag = allTags[i];
                    %>
                        <div class="category-card <%= typeof activeTag !== 'undefined' && activeTag === tag.value ? 'active' : '' %>" 
                             onclick="location.href='/listings?tag=<%= tag.value %>'">
                            <div class="category-icon"><%= tag.icon %></div>
                            <div class="category-name"><%= tag.label %></div>
                        </div>
                    <% } %>
                </div>
            </div>
            <% } %>
            
            <!-- Stats Bar -->
            <div class="stats-bar">
                <div class="results-count">
                    <i class="fas fa-fire"></i> 
                    <span><%= (typeof allListing !== 'undefined' && allListing) ? allListing.length : 0 %></span> amazing places found
                </div>
                <div>
                    <select class="sort-select" id="sortSelect">
                        <option value="newest">✨ Newest First</option>
                        <option value="price_low">💰 Price: Low to High</option>
                        <option value="price_high">💎 Price: High to Low</option>
                    </select>
                </div>
            </div>
            
            <!-- Listings Grid -->
            <% if (typeof allListing !== 'undefined' && allListing && allListing.length > 0) { %>
                <div class="row g-4">
                    <% for(var i = 0; i < allListing.length; i++) { 
                        var listing = allListing[i];
                    %>
                        <div class="col-md-6 col-lg-4">
                            <div class="premium-card">
                                <% if (i < 3) { %>
                                    <div class="card-badge featured">
                                        <i class="fas fa-crown"></i> Featured
                                    </div>
                                <% } %>
                                <div class="image-wrapper">
                                    <img src="<%= listing.image && listing.image.url ? listing.image.url : 'https://via.placeholder.com/400x260' %>" 
                                         class="card-image" 
                                         alt="<%= listing.title %>"
                                         onerror="this.src='https://via.placeholder.com/400x260'">
                                    <div class="overlay">
                                        <div class="overlay-price">
                                            $<%= listing.price %><small>/night</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-content">
                                    <h3 class="card-title"><%= listing.title %></h3>
                                    <div class="card-location">
                                        <i class="fas fa-map-marker-alt"></i> <%= listing.location %>, <%= listing.country %>
                                    </div>
                                    
                                    <!-- Tags -->
                                    <% if (listing.tags && listing.tags.length > 0) { %>
                                        <div class="tags-cloud">
                                            <% for(var j = 0; j < Math.min(listing.tags.length, 3); j++) { %>
                                                <span class="tag-pill"><%= listing.tags[j] %></span>
                                            <% } %>
                                            <% if (listing.tags.length > 3) { %>
                                                <span class="tag-pill">+<%= listing.tags.length - 3 %></span>
                                            <% } %>
                                        </div>
                                    <% } %>
                                    
                                    <div class="card-footer">
                                        <div class="price-tag">
                                            $<%= listing.price %> <small>/night</small>
                                        </div>
                                        <a href="/listings/<%= listing._id %>" class="explore-btn">
                                            Explore <i class="fas fa-arrow-right"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <i class="fas fa-search"></i>
                    <h3>No listings found</h3>
                    <p class="text-muted">We couldn't find any properties matching your criteria.</p>
                    <% if (currUser) { %>
                        <a href="/listings/new" class="btn btn-add mt-3">
                            <i class="fas fa-plus-circle"></i> List Your Property
                        </a>
                    <% } else { %>
                        <a href="/login" class="btn btn-primary mt-3">Login to List Your Property</a>
                    <% } %>
                </div>
            <% } %>
            
            <!-- CTA Banner -->
            <div class="cta-banner">
                <h3 style="font-family: 'Playfair Display', serif;">Ready to Share Your Space?</h3>
                <p>Join thousands of hosts earning extra income</p>
                <% if (currUser) { %>
                    <a href="/listings/new" class="cta-button">
                        Start Hosting Today <i class="fas fa-arrow-right"></i>
                    </a>
                <% } else { %>
                    <a href="/signup" class="cta-button">
                        Join as a Host <i class="fas fa-arrow-right"></i>
                    </a>
                <% } %>
            </div>
        </div>
    </div>
    
    <%- include('../includes/footer.ejs') %>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Sort functionality
        document.getElementById('sortSelect').addEventListener('change', function() {
            var sortValue = this.value;
            var currentUrl = new URL(window.location.href);
            currentUrl.searchParams.set('sort', sortValue);
            window.location.href = currentUrl.toString();
        });
        
        // Animate on scroll
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };
        
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, observerOptions);
        
        document.querySelectorAll('.premium-card').forEach(card => {
            card.style.opacity = '0';
            card.style.transform = 'translateY(30px)';
            card.style.transition = 'all 0.6s ease-out';
            observer.observe(card);
        });
    </script>
</body>
</html>