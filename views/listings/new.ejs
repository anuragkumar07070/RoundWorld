<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add New Listing - RoundWorld</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .form-container {
            max-width: 800px;
            margin: 2rem auto;
        }
        
        .form-card {
            border: none;
            border-radius: 1rem;
            overflow: hidden;
        }
        
        .form-header {
            background-color: #fe424d;
            color: white;
            padding: 1.5rem;
            text-align: center;
        }
        
        .form-header h2 {
            margin: 0;
            font-size: 1.8rem;
            font-weight: 500;
        }
        
        .form-header p {
            margin: 0.5rem 0 0;
            opacity: 0.9;
        }
        
        .form-body {
            padding: 2rem;
        }
        
        .form-group {
            margin-bottom: 1.5rem;
        }
        
        .form-label {
            font-weight: 500;
            color: #222222;
            margin-bottom: 0.5rem;
            display: block;
        }
        
        .form-label i {
            color: #fe424d;
            margin-right: 0.5rem;
        }
        
        .required-star {
            color: #fe424d;
        }
        
        .form-control, .form-select {
            border: 1px solid #dee2e6;
            border-radius: 0.5rem;
            padding: 0.75rem 1rem;
            transition: all 0.2s;
        }
        
        .form-control:focus, .form-select:focus {
            border-color: #fe424d;
            box-shadow: 0 0 0 0.2rem rgba(254, 66, 77, 0.25);
            outline: none;
        }
        
        textarea.form-control {
            resize: vertical;
            min-height: 120px;
        }
        
        .tags-section {
            background: #f8f9fa;
            border-radius: 0.75rem;
            padding: 1.25rem;
            margin: 1.5rem 0;
        }
        
        .tags-title {
            font-weight: 500;
            margin-bottom: 1rem;
            color: #222222;
        }
        
        .tags-title i {
            color: #fe424d;
            margin-right: 0.5rem;
        }
        
        .tags-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
            gap: 0.75rem;
        }
        
        .tag-option {
            position: relative;
        }
        
        .tag-option input {
            position: absolute;
            opacity: 0;
        }
        
        .tag-option label {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0.6rem 1rem;
            background: white;
            border: 1px solid #dee2e6;
            border-radius: 2rem;
            cursor: pointer;
            transition: all 0.2s;
            font-size: 0.9rem;
            gap: 0.5rem;
        }
        
        .tag-option input:checked + label {
            background: #fe424d;
            border-color: #fe424d;
            color: white;
        }
        
        .tag-option label:hover {
            border-color: #fe424d;
            transform: translateY(-1px);
        }
        
        .selected-count {
            font-size: 0.85rem;
            color: #6c757d;
            margin-top: 0.75rem;
            text-align: right;
        }
        
        .selected-count span {
            color: #fe424d;
            font-weight: 600;
        }
        
        .image-upload {
            border: 2px dashed #dee2e6;
            border-radius: 0.75rem;
            padding: 2rem;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s;
            background: #f8f9fa;
        }
        
        .image-upload:hover {
            border-color: #fe424d;
            background: #fff5f5;
        }
        
        .image-upload i {
            font-size: 2.5rem;
            color: #fe424d;
            margin-bottom: 0.5rem;
        }
        
        .image-upload p {
            margin: 0;
            color: #6c757d;
        }
        
        .image-upload small {
            color: #adb5bd;
        }
        
        #imagePreview {
            margin-top: 1rem;
            max-width: 200px;
            border-radius: 0.5rem;
            display: none;
        }
        
        .btn-submit {
            background-color: #fe424d;
            color: white;
            border: none;
            border-radius: 0.5rem;
            padding: 0.75rem 1.5rem;
            font-weight: 500;
            width: 100%;
            transition: all 0.2s;
        }
        
        .btn-submit:hover {
            background-color: #dc3545;
            transform: translateY(-1px);
        }
        
        .btn-cancel {
            background-color: #6c757d;
            color: white;
            border: none;
            border-radius: 0.5rem;
            padding: 0.75rem 1.5rem;
            font-weight: 500;
            width: 100%;
            text-align: center;
            text-decoration: none;
            display: block;
        }
        
        .btn-cancel:hover {
            background-color: #5a6268;
            color: white;
            transform: translateY(-1px);
        }
    </style>
</head>
<body>
    <%- include('../includes/navbar.ejs') %>
    
    <div class="container">
        <div class="form-container">
            <div class="card form-card shadow-sm">
                <div class="form-header">
                    <h2><i class="fas fa-plus-circle"></i> List Your Space</h2>
                    <p>Share your place with travelers worldwide</p>
                </div>
                
                <div class="form-body">
                    <form action="/listings" method="POST" enctype="multipart/form-data" id="listingForm">
                        <div class="form-group">
                            <label class="form-label">
                                <i class="fas fa-heading"></i> Title
                                <span class="required-star">*</span>
                            </label>
                            <input type="text" name="listing[title]" class="form-control" placeholder="Give your place a catchy title" required>
                        </div>
                        
                        <div class="form-group">
                            <label class="form-label">
                                <i class="fas fa-align-left"></i> Description
                                <span class="required-star">*</span>
                            </label>
                            <textarea name="listing[description]" class="form-control" placeholder="Describe what makes your place special..." required></textarea>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">
                                        <i class="fas fa-dollar-sign"></i> Price / night
                                        <span class="required-star">*</span>
                                    </label>
                                    <input type="number" name="listing[price]" class="form-control" placeholder="e.g., 100" min="0" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">
                                        <i class="fas fa-map-marker-alt"></i> Location
                                        <span class="required-star">*</span>
                                    </label>
                                    <input type="text" name="listing[location]" class="form-control" placeholder="e.g., Downtown" required>
                                </div>
                            </div>
                        </div>
                        
                        <div class="form-group">
                            <label class="form-label">
                                <i class="fas fa-globe"></i> Country
                                <span class="required-star">*</span>
                            </label>
                            <input type="text" name="listing[country]" class="form-control" placeholder="e.g., United States" required>
                        </div>
                        
                        <div class="tags-section">
                            <div class="tags-title">
                                <i class="fas fa-tags"></i> Select Tags (Max 3)
                            </div>
                            <div class="tags-grid">
                                <div class="tag-option">
                                    <input type="checkbox" name="tags" value="beach" id="tag-beach">
                                    <label for="tag-beach">🏖️ Beach</label>
                                </div>
                                <div class="tag-option">
                                    <input type="checkbox" name="tags" value="mountain" id="tag-mountain">
                                    <label for="tag-mountain">⛰️ Mountain</label>
                                </div>
                                <div class="tag-option">
                                    <input type="checkbox" name="tags" value="desert" id="tag-desert">
                                    <label for="tag-desert">🏜️ Desert</label>
                                </div>
                                <div class="tag-option">
                                    <input type="checkbox" name="tags" value="forest" id="tag-forest">
                                    <label for="tag-forest">🌲 Forest</label>
                                </div>
                                <div class="tag-option">
                                    <input type="checkbox" name="tags" value="lake" id="tag-lake">
                                    <label for="tag-lake">🏞️ Lake</label>
                                </div>
                                <div class="tag-option">
                                    <input type="checkbox" name="tags" value="city" id="tag-city">
                                    <label for="tag-city">🏙️ City</label>
                                </div>
                                <div class="tag-option">
                                    <input type="checkbox" name="tags" value="luxury" id="tag-luxury">
                                    <label for="tag-luxury">💎 Luxury</label>
                                </div>
                                <div class="tag-option">
                                    <input type="checkbox" name="tags" value="budget" id="tag-budget">
                                    <label for="tag-budget">💰 Budget</label>
                                </div>
                                <div class="tag-option">
                                    <input type="checkbox" name="tags" value="family" id="tag-family">
                                    <label for="tag-family">👨‍👩‍👧‍👦 Family</label>
                                </div>
                                <div class="tag-option">
                                    <input type="checkbox" name="tags" value="romantic" id="tag-romantic">
                                    <label for="tag-romantic">❤️ Romantic</label>
                                </div>
                                <div class="tag-option">
                                    <input type="checkbox" name="tags" value="adventure" id="tag-adventure">
                                    <label for="tag-adventure">🧗 Adventure</label>
                                </div>
                                <div class="tag-option">
                                    <input type="checkbox" name="tags" value="ski" id="tag-ski">
                                    <label for="tag-ski">🎿 Ski</label>
                                </div>
                            </div>
                            <div class="selected-count">
                                Selected: <span id="selectedCount">0</span> / 3
                            </div>
                        </div>
                        
                        <div class="form-group">
                            <label class="form-label">
                                <i class="fas fa-image"></i> Property Image
                            </label>
                            <div class="image-upload" onclick="document.getElementById('imageInput').click()">
                                <i class="fas fa-cloud-upload-alt"></i>
                                <p>Click to upload an image</p>
                                <small>PNG, JPG, JPEG up to 5MB</small>
                            </div>
                            <input type="file" name="listing[image]" id="imageInput" style="display: none" accept="image/*" onchange="previewImage(this)">
                            <img id="imagePreview" alt="Preview">
                        </div>
                        
                        <div class="row mt-4">
                            <div class="col-md-6">
                                <button type="submit" class="btn-submit">
                                    <i class="fas fa-check-circle"></i> Create Listing
                                </button>
                            </div>
                            <div class="col-md-6">
                                <a href="/listings" class="btn-cancel">
                                    <i class="fas fa-times"></i> Cancel
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    
    <%- include('../includes/footer.ejs') %>
    
    <script>
        var checkboxes = document.querySelectorAll('input[name="tags"]');
        var selectedCountSpan = document.getElementById('selectedCount');
        
        function updateSelectedCount() {
            var checked = document.querySelectorAll('input[name="tags"]:checked');
            selectedCountSpan.textContent = checked.length;
            
            if (checked.length >= 3) {
                for(var i = 0; i < checkboxes.length; i++) {
                    if (!checkboxes[i].checked) {
                        checkboxes[i].disabled = true;
                    }
                }
            } else {
                for(var i = 0; i < checkboxes.length; i++) {
                    checkboxes[i].disabled = false;
                }
            }
        }
        
        for(var i = 0; i < checkboxes.length; i++) {
            checkboxes[i].addEventListener('change', updateSelectedCount);
        }
        
        function previewImage(input) {
            var preview = document.getElementById('imagePreview');
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    preview.style.display = 'block';
                    preview.src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
        
        document.getElementById('listingForm').addEventListener('submit', function(e) {
            var checked = document.querySelectorAll('input[name="tags"]:checked');
            if (checked.length === 0) {
                e.preventDefault();
                alert('Please select at least one tag for your listing!');
            }
        });
        
        updateSelectedCount();
    </script>
</body>
</html>