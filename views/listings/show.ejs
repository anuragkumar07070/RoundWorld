<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= listing.title %> - RoundWorld</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .listing-image {
            height: 400px;
            object-fit: cover;
            width: 100%;
        }
        .tag-badge {
            display: inline-block;
            padding: 5px 12px;
            margin: 3px;
            border-radius: 20px;
            font-size: 13px;
            background: #f0f0f0;
            color: #333;
        }
        .review-card {
            border-bottom: 1px solid #eee;
            padding: 15px 0;
        }
        .review-card:last-child {
            border-bottom: none;
        }
        .rating-stars {
            color: #ffc107;
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="fas fa-compass text-danger"></i>
                <span class="fw-bold">RoundWorld</span>
            </a>
            <div class="ms-auto">
                <% if (currUser) { %>
                    <span class="me-3">Hello, <%= currUser.username %></span>
                    <a href="/logout" class="btn btn-danger btn-sm">Logout</a>
                <% } else { %>
                    <a href="/login" class="btn btn-outline-primary btn-sm me-2">Login</a>
                    <a href="/signup" class="btn btn-primary btn-sm">Sign Up</a>
                <% } %>
            </div>
        </div>
    </nav>

    <div class="container my-5">
        <div class="row">
            <div class="col-md-8 mx-auto">
                <!-- Back button -->
                <a href="/listings" class="btn btn-secondary mb-4">
                    <i class="fas fa-arrow-left"></i> Back to Listings
                </a>

                <!-- Image -->
                <div class="card shadow-sm mb-4">
                    <img src="<%= listing.image && listing.image.url ? listing.image.url : 'https://via.placeholder.com/800x400' %>" 
                         class="listing-image card-img-top" 
                         alt="<%= listing.title %>"
                         onerror="this.src='https://via.placeholder.com/800x400'">
                </div>

                <!-- Title and Price -->
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div>
                        <h1 class="display-5 fw-bold"><%= listing.title %></h1>
                        <p class="text-muted">
                            <i class="fas fa-map-marker-alt text-danger"></i> 
                            <%= listing.location %>, <%= listing.country %>
                        </p>
                    </div>
                    <div class="text-end">
                        <h2 class="text-primary">$<%= listing.price %></h2>
                        <p class="text-muted">per night</p>
                    </div>
                </div>

                <!-- Tags -->
                <% if (listing.tags && listing.tags.length > 0) { %>
                    <div class="mb-4">
                        <h6><i class="fas fa-tags"></i> Tags</h6>
                        <div>
                            <% for(var i = 0; i < listing.tags.length; i++) { %>
                                <span class="tag-badge">
                                    <%= listing.tags[i] %>
                                </span>
                            <% } %>
                        </div>
                    </div>
                <% } %>

                <!-- Host Info -->
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <h5><i class="fas fa-user-circle"></i> Hosted by</h5>
                        <% if (listing.owner && listing.owner.username) { %>
                            <p class="h4 mb-0"><%= listing.owner.username %></p>
                        <% } else { %>
                            <p class="text-muted mb-0">Host information unavailable</p>
                        <% } %>
                    </div>
                </div>

                <!-- Description -->
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <h5>About this place</h5>
                        <p><%= listing.description %></p>
                    </div>
                </div>

                <!-- Action Buttons for Owner -->
                <% if (isOwner && currUser) { %>
                    <div class="d-flex gap-3 mb-4">
                        <a href="/listings/<%= listing._id %>/edit" class="btn btn-warning">
                            <i class="fas fa-edit"></i> Edit Listing
                        </a>
                        <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" 
                              onsubmit="return confirm('Are you sure you want to delete this listing?')">
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-trash"></i> Delete Listing
                            </button>
                        </form>
                    </div>
                <% } %>

                <!-- Reviews Section -->
                <div class="card shadow-sm">
                    <div class="card-header bg-white">
                        <h5><i class="fas fa-star text-warning"></i> Reviews</h5>
                    </div>
                    <div class="card-body">
                        <% if (listing.reviews && listing.reviews.length > 0) { %>
                            <% for(var i = 0; i < listing.reviews.length; i++) { 
                                var review = listing.reviews[i];
                            %>
                                <div class="review-card">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <strong>
                                            <i class="fas fa-user-circle"></i> 
                                            <%= review.author && review.author.username ? review.author.username : 'Anonymous' %>
                                        </strong>
                                        <span class="rating-stars">
                                            <% for(var s = 1; s <= 5; s++) { %>
                                                <% if (s <= review.rating) { %>
                                                    <i class="fas fa-star"></i>
                                                <% } else { %>
                                                    <i class="far fa-star"></i>
                                                <% } %>
                                            <% } %>
                                        </span>
                                    </div>
                                    <p class="mb-2"><%= review.comment %></p>
                                    <small class="text-muted">
                                        <i class="far fa-calendar-alt"></i>
                                        <%= review.createdAt ? review.createdAt.toLocaleDateString() : 'Recently' %>
                                    </small>
                                </div>
                            <% } %>
                        <% } else { %>
                            <p class="text-muted text-center mb-0 py-3">
                                <i class="far fa-comment-dots fa-2x mb-2 d-block"></i>
                                No reviews yet. Be the first to review!
                            </p>
                        <% } %>
                        
                        <!-- Add Review Form (only for logged in users who are not the owner) -->
                        <% if (currUser && !isOwner) { %>
                            <hr>
                            <h6>Add a Review</h6>
                            <form action="/listings/<%= listing._id %>/reviews" method="POST">
                                <div class="mb-3">
                                    <label class="form-label">Rating</label>
                                    <select name="review[rating]" class="form-select" required>
                                        <option value="">Select rating</option>
                                        <option value="5">5 - Excellent</option>
                                        <option value="4">4 - Very Good</option>
                                        <option value="3">3 - Good</option>
                                        <option value="2">2 - Fair</option>
                                        <option value="1">1 - Poor</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Comment</label>
                                    <textarea name="review[comment]" class="form-control" rows="3" required minlength="5"></textarea>
                                </div>
                                <button type="submit" class="btn btn-primary">Submit Review</button>
                            </form>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-light text-center text-muted py-4 mt-5">
        <div class="container">
            <small>&copy; 2024 RoundWorld. All rights reserved.</small>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>